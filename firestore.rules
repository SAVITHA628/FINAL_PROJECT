rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    function isOwner(ownerUid) {
      return isAuth() && uid() == ownerUid;
    }

    function isActiveUser() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.isActive != false;
    }

    // ── USERS ────────────────────────────────────────────────────
    // Admin: full access to all users
    // User: read/update own profile only
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAuth() && uid() == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── ITEMS ────────────────────────────────────────────────────
    // Admin: full access to all items
    // User: read all active items, write/update own items
    match /items/{itemId} {
      allow read:   if isAuth();
      allow create: if isActiveUser() && request.resource.data.reportedBy == uid();
      allow update: if isAdmin() || (isOwner(resource.data.reportedBy) && isActiveUser());
      allow delete: if isAdmin() || isOwner(resource.data.reportedBy);
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────
    // Admin: full access
    // User: read/update own notifications
    match /notifications/{notifId} {
      allow read:   if isAuth() && (resource.data.recipientId == uid() || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.recipientId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── MATCHES ──────────────────────────────────────────────────
    // Admin: full access
    // User: read only
    match /matches/{matchId} {
      allow read:  if isAuth();
      allow write: if isAdmin();
    }

    // ── ADMIN STATS ──────────────────────────────────────────────
    // Admin only
    match /admin_stats/{document} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
