rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    function isOwner(ownerUid) {
      return isAuth() && uid() == ownerUid;
    }

    function isActiveUser() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.isActive != false;
    }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAuth() && uid() == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── items ─────────────────────────────────────────────────────────
    match /items/{itemId} {
      // Any authenticated active user can read active items;
      // admins can read all items regardless of isActive flag
      allow read: if isActiveUser() &&
                     (resource.data.isActive == true || isAdmin());

      // Any authenticated active user can create an item
      allow create: if isActiveUser()
                    && request.resource.data.reportedBy == uid()
                    && request.resource.data.status == 'active'
                    && request.resource.data.isActive == true;

      // Owner can update their own items; admin can update any
      allow update: if isAdmin()
                    || (isOwner(resource.data.reportedBy) && isActiveUser());

      // Soft-delete only (isActive = false); admin or owner
      allow delete: if isAdmin()
                    || isOwner(resource.data.reportedBy);
    }

    // ── notifications ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && (
                      resource.data.recipientId == uid() || isAdmin()
                    );
      // Only Cloud Functions (Admin SDK) create notifications
      allow write:  if false;
    }

    // ── admin_stats ────────────────────────────────────────────────────
    match /admin_stats/{doc} {
      allow read:  if isAdmin();
      // Written exclusively by Cloud Functions via Admin SDK
      allow write: if false;
    }
  }
}
