rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.role == 'admin';
    }

    function isOwner(ownerUid) {
      return isAuth() && uid() == ownerUid;
    }

    function isActiveUser() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(uid())).data.isActive != false;
    }

    // ── users ─────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isAuth() && uid() == userId && (request.resource.data.role == 'user' || isAdmin());
      allow update: if (isOwner(userId) && (request.resource.data.role == resource.data.role || isAdmin())) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── items ─────────────────────────────────────────────────────────
    match /items/{itemId} {
      allow read: if isActiveUser() && (resource.data.isActive == true || isAdmin());
      allow create: if isActiveUser()
                    && request.resource.data.reportedBy == uid()
                    && request.resource.data.isActive == true;
      allow update: if isAdmin() || (isOwner(resource.data.reportedBy) && isActiveUser());
      allow delete: if isAdmin() || isOwner(resource.data.reportedBy);
    }

    // ── matches ───────────────────────────────────────────────────────
    match /matches/{matchId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // ── notifications ─────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read:   if isAuth() && (resource.data.recipientId == uid() || isAdmin());
      allow create: if isAuth();
      allow update: if isAuth() && (resource.data.recipientId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── admin_stats ────────────────────────────────────────────────────
    match /admin_stats/{doc} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
