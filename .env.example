# FoundIt Environment Variables Configuration Template
# Copy this file to .env and fill in your environment values for local deployment.

# Python AI Service Configuration
PORT=8000
HOST=0.0.0.0
MATCH_THRESHOLD=0.55
IMAGE_WEIGHT=0.50
TEXT_WEIGHT=0.50
LOG_LEVEL=INFO

# Firebase Configuration (Replace with your Firebase Project ID)
FIREBASE_PROJECT_ID=foundit-6bc8a
FIREBASE_DATABASE_URL=https://firestore.googleapis.com/v1/projects/foundit-6bc8a/databases/(default)/documents

# Flutter Mobile API Endpoint (Default client-side matching fallback used for standalone APK)
FOUNDIT_AI_SERVICE_URL=http://localhost:8000
